---
/**
 * Page hors ligne (servie par le service worker quand le réseau est indisponible).
 * Volontairement autonome : aucune ressource externe, styles en ligne.
 * Le lien d'appel fonctionne sans connexion Internet.
 */
import { site } from '../config/site';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0c0c0d" />
    <title>Hors connexion — Taxi Saint Irénée</title>
    <style is:inline>
      :root { color-scheme: light dark; --bg: #f5f4f0; --ink: #0c0c0d; --muted: #646468; --line: rgba(12,12,13,.12); }
      @media (prefers-color-scheme: dark) { :root { --bg: #0c0c0d; --ink: #f2f1ec; --muted: #9d9ca1; --line: rgba(255,255,255,.12); } }
      * { box-sizing: border-box; margin: 0; }
      body { min-height: 100svh; display: grid; place-items: center; padding: 1.5rem; background: var(--bg); color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; line-height: 1.55; }
      main { width: min(100%, 26rem); }
      .k { font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; }
      h1 { margin-top: 1.5rem; font-size: 1.75rem; line-height: 1.15; letter-spacing: -.03em; font-weight: 500; }
      p { margin-top: .75rem; color: var(--muted); }
      a.call { display: flex; align-items: center; justify-content: center; min-height: 3.5rem; margin-top: 2rem; border-radius: 999px;
        background: var(--ink); color: var(--bg); text-decoration: none; font-weight: 500; font-size: 1.0625rem; }
      .en { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
      .en h2 { font-size: 1rem; font-weight: 500; }
    </style>
  </head>
  <body>
    <main>
      <p class="k">Taxi Saint Irénée</p>
      <h1>Vous êtes hors connexion.</h1>
      <p>La réservation en ligne sera disponible dès le retour du réseau. Vous pouvez nous appeler dès maintenant.</p>
      <a class="call" href={site.phone.href}>Appeler le {site.phone.display}</a>
      <div class="en" lang="en">
        <h2>You are offline.</h2>
        <p>Online booking will be available again once you are connected. You can call us right now on {site.phone.international}.</p>
      </div>
    </main>
  </body>
</html>
