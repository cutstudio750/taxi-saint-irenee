---
import { t, type Lang } from '../i18n';
import { communes } from '../data/zones';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const z = d.zone;
const rings = lang === 'fr' ? ['Lyon', 'Métropole', 'Région', 'Longue distance'] : ['Lyon', 'Metropolitan area', 'Region', 'Long distance'];
---
<section class="section zone" id={d.ids.zone} aria-labelledby="zone-title">
  <div class="container zone__grid">
    <div class="zone__body">
      <div data-reveal>
        <p class="label"><span class="label__index">08</span>{z.label}</p>
        <h2 class="h2 zone__title" id="zone-title">{z.title}</h2>
        <p class="lead zone__lead">{z.text}</p>
      </div>

      <div class="zone__block" data-reveal style="--d:120ms">
        <h3 class="zone__h">{z.communesTitle}</h3>
        <ul class="tags" role="list">
          {communes.map((c) => <li>{c}</li>)}
        </ul>
        <p class="zone__note">{z.note}</p>
      </div>

      <div class="zone__block" data-reveal style="--d:200ms">
        <h3 class="zone__h">{z.hubsTitle}</h3>
        <ul class="tags" role="list">
          {z.hubs.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </div>

    <figure class="zone__map" aria-hidden="true" data-reveal style="--d:160ms">
      <svg viewBox="0 0 400 400" focusable="false">
        <circle cx="200" cy="200" r="188" class="ring ring--dash" />
        <circle cx="200" cy="200" r="138" class="ring" />
        <circle cx="200" cy="200" r="86" class="ring" />
        <circle cx="200" cy="200" r="38" class="ring ring--core" />
        <circle cx="200" cy="200" r="5" class="core" />
      </svg>
      <span class="zone__tag zone__tag--0">{rings[0]}</span>
      <span class="zone__tag zone__tag--1">{rings[1]}</span>
      <span class="zone__tag zone__tag--2">{rings[2]}</span>
      <span class="zone__tag zone__tag--3 glass">{rings[3]}</span>
    </figure>
  </div>
</section>

<style>
  .zone__grid { display: grid; gap: clamp(3rem, 6vw, 5rem); align-items: center; }
  .zone__title { margin-top: 1.25rem; }
  .zone__lead { margin-top: 1.25rem; }
  .zone__block { margin-top: 2.25rem; }
  .zone__h {
    margin-bottom: 0.85rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags li {
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .zone__note { margin-top: 0.85rem; font-size: 0.875rem; color: var(--muted); }

  .zone__map {
    position: relative;
    width: min(100%, 30rem);
    margin: 0 auto;
    aspect-ratio: 1;
  }
  .zone__map svg { width: 100%; height: 100%; overflow: visible; }
  .ring { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .ring--dash { stroke-dasharray: 2 6; }
  .ring--core { fill: var(--accent-soft); stroke: color-mix(in srgb, var(--accent) 40%, transparent); }
  .core { fill: var(--ink); }
  .zone__tag {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: var(--muted);
    background: var(--bg);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
  }
  .zone__tag--0 { left: 50%; top: calc(50% + 11.5%); color: var(--ink); background: transparent; }
  .zone__tag--1 { left: 50%; top: calc(50% - 21.5%); }
  .zone__tag--2 { left: 50%; top: calc(50% - 34.5%); }
  .zone__tag--3 {
    left: 50%; top: calc(50% + 47%);
    padding: 0.4rem 0.85rem;
    color: var(--ink);
    --glass-blur: 12px;
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 0 0 1px var(--glass-edge), var(--shadow-sm);
  }
  @media (min-width: 64rem) {
    .zone__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
</style>
