---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
import type { IconName } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const m = d.services.medical;
---
<section class="section services" id={d.ids.services} aria-labelledby="services-title">
  <div class="container">
    <div class="section__head section__head--split" data-reveal>
      <p class="label"><span class="label__index">04</span>{d.services.label}</p>
      <h2 class="h2" id="services-title">{d.services.title}</h2>
      <p class="lead">{d.services.lead}</p>
    </div>
    <ul class="services__list" role="list">
      {d.services.items.map((s, i) => (
        <li class="service" data-reveal style={`--d:${(i % 4) * 70}ms`}>
          <span class="service__icon"><Icon name={s.icon as IconName} /></span>
          <h3 class="h3 service__title">{s.title}</h3>
          <p class="service__text">{s.text}</p>
        </li>
      ))}
    </ul>

    <!-- Transport médical conventionné CPAM -->
    <article class="cpam" id={d.ids.medical} aria-labelledby="cpam-title" data-reveal>
      <div class="cpam__main">
        <p class="label cpam__label"><Icon name="medical" />{m.label}</p>
        <h3 class="cpam__title" id="cpam-title">{m.title}</h3>
        <p class="cpam__text">{m.text}</p>
        <ul class="cpam__points" role="list">
          {m.points.map((p) => (
            <li><Icon name="check" />{p}</li>
          ))}
        </ul>
        <div class="cpam__actions">
          <a class="btn btn--primary btn--lg" href={`#${d.ids.booking}`} data-book data-book-mode="medical">
            {m.cta}<Icon name="arrowRight" class="btn__arrow" />
          </a>
          <a class="link cpam__ameli" href={m.ameliUrl} target="_blank" rel="noopener">
            {m.ameli}<span class="sr-only"> {d.a11y.newTab}</span>
          </a>
        </div>
      </div>

      <div class="cpam__bring">
        <h4 class="cpam__bring-title">{m.bringTitle}</h4>
        <ul class="cpam__list" role="list">
          {m.bring.map((b) => (
            <li>
              <span class="cpam__icon"><Icon name={b.icon as IconName} /></span>
              <span>
                <strong>{b.title}</strong>
                <span class="cpam__sub">{b.text}</span>
              </span>
            </li>
          ))}
        </ul>
        <p class="cpam__note">{m.note}</p>
      </div>
    </article>
  </div>
</section>

<style>
  .services__list { border-bottom: 1px solid var(--line); }
  .service {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.3rem;
    align-items: center;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }
  .service__icon {
    grid-row: span 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .service__icon :global(svg) { width: 1.25rem; height: 1.25rem; }
  .service__text { color: var(--muted); }

  /* ---------- Bloc transport médical ---------- */
  .cpam {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-md);
  }
  .cpam__label :global(svg) { width: 0.9rem; height: 0.9rem; color: var(--ink); }
  .cpam__title {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  .cpam__text { margin-top: 1rem; color: var(--ink-2); max-width: 38em; font-size: 1.0625rem; }
  .cpam__points { display: grid; gap: 0.6rem; margin-top: 1.5rem; }
  .cpam__points li { display: grid; grid-template-columns: 1.25rem 1fr; gap: 0.6rem; color: var(--ink-2); }
  .cpam__points :global(svg) { width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; color: var(--ink); }
  .cpam__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  .cpam__ameli { font-size: 0.9375rem; }

  .cpam__bring {
    align-self: start;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
  }
  .cpam__bring-title {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cpam__list { display: grid; gap: 1.1rem; margin-top: 1.1rem; }
  .cpam__list li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.85rem; align-items: start; }
  .cpam__list strong { display: block; font-weight: 500; line-height: 1.35; }
  .cpam__sub { display: block; margin-top: 0.15rem; font-size: 0.875rem; color: var(--muted); line-height: 1.45; }
  .cpam__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .cpam__icon :global(svg) { width: 1.15rem; height: 1.15rem; }
  .cpam__note {
    margin-top: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 29.99rem) {
    .cpam__actions .btn { width: 100%; }
  }
  @media (min-width: 64rem) {
    .service {
      grid-template-columns: 3.25rem minmax(0, 4fr) minmax(0, 6fr);
      column-gap: 2rem;
      padding: 1.75rem 0;
    }
    .service__icon { grid-row: auto; align-self: center; }
    .service__title { font-size: 1.375rem; letter-spacing: -0.02em; }
    .service__text { font-size: 1.0625rem; }
    .cpam { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; }
  }
</style>
