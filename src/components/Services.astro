---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
import type { IconName } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---
<section class="section services" id={d.ids.services} aria-labelledby="services-title">
  <div class="container">
    <div class="section__head section__head--split" data-reveal>
      <p class="label"><span class="label__index">04</span>{d.services.label}</p>
      <h2 class="h2" id="services-title">{d.services.title}</h2>
      <p class="lead">{d.services.lead}</p>
    </div>
    <ul class="services__list" role="list">
      {d.services.items.map((s, i) => (
        <li class="service" data-reveal style={`--d:${(i % 4) * 70}ms`}>
          <span class="service__icon"><Icon name={s.icon as IconName} /></span>
          <h3 class="h3 service__title">{s.title}</h3>
          <p class="service__text">{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__list { border-bottom: 1px solid var(--line); }
  .service {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1rem;
    row-gap: 0.3rem;
    align-items: center;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }
  .service__icon {
    grid-row: span 2;
    align-self: start;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .service__icon :global(svg) { width: 1.25rem; height: 1.25rem; }
  .service__text { color: var(--muted); }
  @media (min-width: 64rem) {
    .service {
      grid-template-columns: 3.25rem minmax(0, 4fr) minmax(0, 6fr);
      column-gap: 2rem;
      padding: 1.75rem 0;
    }
    .service__icon { grid-row: auto; align-self: center; }
    .service__title { font-size: 1.375rem; letter-spacing: -0.02em; }
    .service__text { font-size: 1.0625rem; }
  }
</style>
